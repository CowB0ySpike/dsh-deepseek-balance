{
  "name": "dsh-deepseek-balance",
  "version": "1.3.2",
  "description": "DSH plugin: shows the account balance (or plan quota) of the model provider the current session uses.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "glm",
    "zai",
    "balance",
    "usage"
  ],
  "license": "MIT",
  "author": "CowB0ySpike",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CowB0ySpike/dsh-deepseek-balance.git"
  },
  "bugs": {
    "url": "https://github.com/CowB0ySpike/dsh-deepseek-balance/issues"
  },
  "homepage": "https://github.com/CowB0ySpike/dsh-deepseek-balance#readme",
  "type": "module",
  "scripts": {
    "test": "node test/host.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
